{
  "index_patterns": [
    "credentials-*"
  ],
  "priority": 200,
  "composed_of": [
    "redelk-ecs-base",
    "redelk-common",
    "redelk-c2",
    "redelk-threat"
  ],
  "template": {
    "settings": {
      "index.lifecycle.name": "redelk",
      "index.number_of_shards": 1,
      "index.number_of_replicas": 0,
      "index.refresh_interval": "5s",
      "index.mapping.total_fields.limit": 10000
    },
    "mappings": {
      "dynamic": true,
      "date_detection": false,
      "numeric_detection": false,
      "properties": {
        "type": {
          "type": "keyword",
          "ignore_above": 1024
        }
      }
    }
  },
  "_meta": {
    "managed_by": "redelk",
    "description": "Credentials harvested during the operation. The index pattern is credentials-* because the logstash output writes credentials-%{+YYYY.MM.dd}; the pre-v3 template said 'credentials' without a wildcard and therefore never matched a single index.",
    "authors": [
      "Outflank B.V. / Marc Smeets",
      "Lorenzo Bernardi (@fastlorenzo)"
    ]
  }
}
