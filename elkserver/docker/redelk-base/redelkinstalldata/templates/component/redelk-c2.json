                  "ignore_above": 1024
                }
              }
            },
            "operation": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "operator": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "operator_ip": {
              "type": "ip",
              "ignore_malformed": true
            },
            "program": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "server": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "task": {
              "properties": {
                "completed": {
                  "type": "boolean"
                },
                "id": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "status": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },
            "timestamp": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "creds": {
