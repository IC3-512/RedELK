                    "text": {
                      "type": "text",
                      "norms": false
                    }
                  }
                },
                "host": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "name": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "port": {
                  "type": "long"
                },
                "profile": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "proxy": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "type": {
