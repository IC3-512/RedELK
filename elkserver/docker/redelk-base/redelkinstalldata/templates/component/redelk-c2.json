        "implant": {
          "properties": {
            "arch": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "checkin": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "child_id": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "external_ip": {
              "type": "ip",
              "ignore_malformed": true
            },
            "id": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "input": {
              "type": "keyword",
              "ignore_above": 1024,
              "fields": {
                "text": {
                  "type": "text",
                  "norms": false
                }
              }
            },
            "integrity_level": {
              "type": "long"
            },
            "kill_date": {
              "type": "date",
              "format": "strict_date_optional_time||yyyy-MM-dd HH:mm:ss||epoch_millis",
              "ignore_malformed": true
            },
            "link_mode": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "linked": {
              "type": "boolean"
            },
            "log_file": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "name": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "operator": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "output": {
              "type": "text",
              "norms": false
            },
            "parent_id": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "process_user": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "sleep": {
              "type": "keyword",
              "ignore_above": 1024
            },
