{
  "template": {
    "mappings": {
      "properties": {
        "threat": {
          "properties": {
            "framework": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "tactic": {
              "properties": {
                "id": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "name": {
                  "type": "keyword",
                  "ignore_above": 1024,
                  "fields": {
                    "text": {
                      "type": "text",
                      "norms": false
                    }
                  }
                },
                "reference": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },
            "technique": {
              "properties": {
                "id": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "name": {
                  "type": "keyword",
                  "ignore_above": 1024,
                  "fields": {
                    "text": {
                      "type": "text",
                      "norms": false
                    }
                  }
                },
                "original_id": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "reference": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "subtechnique": {
                  "properties": {
                    "id": {
                      "type": "keyword",
                      "ignore_above": 1024
                    },
                    "name": {
                      "type": "keyword",
                      "ignore_above": 1024,
                      "fields": {
                        "text": {
                          "type": "text",
                          "norms": false
                        }
                      }
                    },
                    "reference": {
                      "type": "keyword",
                      "ignore_above": 1024
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "_meta": {
    "managed_by": "redelk",
    "description": "ECS threat.* for MITRE ATT&CK tracking. Every technique/tactic/sub-technique leaf is a keyword, which in Elasticsearch also accepts an array - one log line can carry several techniques (Cobalt Strike writes '[task] <T1113, T1093> ...' and the logstash filter splits it). Sub-techniques are indexed explicitly under threat.technique.subtechnique and rolled up into threat.technique.id with their parent. threat.technique.original_id keeps the ATT&CK id as it appeared in the source when RedELK remaps a revoked technique to its replacement.",
    "authors": [
      "Outflank B.V. / Marc Smeets",
      "Lorenzo Bernardi (@fastlorenzo)"
    ]
  }
}
