{
  "index_patterns": [
    "implantsdb"
  ],
  "priority": 200,
  "composed_of": [
    "redelk-ecs-base",
    "redelk-common",
    "redelk-c2",
    "redelk-threat"
  ],
  "template": {
    "settings": {
      "index.lifecycle.name": "redelk",
      "index.number_of_shards": 1,
      "index.number_of_replicas": 0,
      "index.refresh_interval": "5s",
      "index.mapping.total_fields.limit": 10000
    },
    "mappings": {
      "dynamic": true,
      "date_detection": false,
      "numeric_detection": false,
      "properties": {
        "screenshot": {
          "properties": {
            "full": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "thumb": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "type": {
          "type": "keyword",
          "ignore_above": 1024
        }
      }
    }
  },
  "_meta": {
    "managed_by": "redelk",
    "description": "One document per implant, updated in place as the implant checks in - which is why this index has no date suffix and no rollover. Fed by the logstash clone{} of the C2 'new implant' log lines and by the Mythic and Outflank C2 connectors, which write the same implant.* fields under a deterministic _id.",
    "authors": [
      "Outflank B.V. / Marc Smeets",
      "Lorenzo Bernardi (@fastlorenzo)"
    ]
  }
}
