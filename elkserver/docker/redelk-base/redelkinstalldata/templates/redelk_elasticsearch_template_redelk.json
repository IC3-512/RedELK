{
  "index_patterns": [
    "redelk-*"
  ],
  "priority": 200,
  "composed_of": [],
  "template": {
    "settings": {
      "index.lifecycle.name": "redelk",
      "index.number_of_shards": 1,
      "index.number_of_replicas": 0,
      "index.refresh_interval": "5s",
      "index.mapping.total_fields.limit": 10000
    },
    "mappings": {
      "dynamic": true,
      "date_detection": false,
      "numeric_detection": false,
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "module": {
          "properties": {
            "last_run": {
              "properties": {
                "count": {
                  "type": "long"
                },
                "message": {
                  "type": "keyword",
                  "ignore_above": 1024,
                  "fields": {
                    "text": {
                      "type": "text",
                      "norms": false
                    }
                  }
                },
                "status": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "timestamp": {
                  "type": "date"
                }
              }
            },
            "name": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "type": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "type": {
          "type": "keyword",
          "ignore_above": 1024
        }
      }
    }
  },
  "_meta": {
    "managed_by": "redelk",
    "description": "Bookkeeping for the RedELK daemon: redelk-modules holds one document per alarm/enrich module recording its last run. numeric_detection is off because it turns any numeric-looking string into a long and then rejects the next document that puts a non-numeric value in the same field. The IP and domain lists live under redelk-iplist-* and redelk-domainslist-*, which are claimed by their own higher priority templates.",
    "authors": [
      "Outflank B.V. / Marc Smeets",
      "Lorenzo Bernardi (@fastlorenzo)"
    ]
  }
}
