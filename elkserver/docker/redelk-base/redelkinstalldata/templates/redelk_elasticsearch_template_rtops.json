{
  "index_patterns": [
    "rtops-*"
  ],
  "priority": 200,
  "composed_of": [
    "redelk-ecs-base",
    "redelk-common",
    "redelk-c2",
    "redelk-threat"
  ],
  "template": {
    "settings": {
      "index.lifecycle.name": "redelk",
      "index.number_of_shards": 1,
      "index.number_of_replicas": 0,
      "index.refresh_interval": "5s",
      "index.mapping.total_fields.limit": 10000
    },
    "mappings": {
      "dynamic": true,
      "date_detection": false,
      "numeric_detection": false,
      "properties": {
        "keystrokes": {
          "properties": {
            "desktop_session": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "url": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "user": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "screenshot": {
          "properties": {
            "desktop_session": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "file_name": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "full": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "thumb": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "title": {
              "type": "keyword",
              "ignore_above": 1024,
              "fields": {
                "text": {
                  "type": "text",
                  "norms": false
                }
              }
            }
          }
        },
        "type": {
          "type": "keyword",
          "ignore_above": 1024
        }
      }
    }
  },
  "_meta": {
    "managed_by": "redelk",
    "description": "Red team operations log: every line the C2 frameworks produced, arriving either through logstash (Cobalt Strike, PoshC2, Sliver, Outflank Stage1) or straight from the Mythic and Outflank C2 connectors. The C2 fields themselves live in the redelk-c2 component so that both ingestion paths share one definition.",
    "authors": [
      "Outflank B.V. / Marc Smeets",
      "Lorenzo Bernardi (@fastlorenzo)"
    ]
  }
}
