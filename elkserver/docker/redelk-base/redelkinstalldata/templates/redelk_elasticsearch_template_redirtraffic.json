{
  "index_patterns": [
    "redirtraffic-*"
  ],
  "priority": 200,
  "composed_of": [
    "redelk-ecs-base",
    "redelk-common"
  ],
  "template": {
    "settings": {
      "index.lifecycle.name": "redelk",
      "index.number_of_shards": 1,
      "index.number_of_replicas": 0,
      "index.refresh_interval": "5s",
      "index.mapping.total_fields.limit": 10000
    },
    "mappings": {
      "dynamic": true,
      "date_detection": false,
      "numeric_detection": false,
      "properties": {
        "destination": {
          "properties": {
            "as": {
              "properties": {
                "number": {
                  "type": "long"
                },
                "organization": {
                  "properties": {
                    "name": {
                      "type": "keyword",
                      "ignore_above": 1024,
                      "fields": {
                        "text": {
                          "type": "text",
                          "norms": false
                        }
                      }
                    }
                  }
                }
              }
            },
            "domain": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "geo": {
              "properties": {
                "city_name": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "continent_code": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "continent_name": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "country_iso_code": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "country_name": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "location": {
                  "type": "geo_point"
                },
                "name": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "postal_code": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "region_iso_code": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "region_name": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "timezone": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },
            "ip": {
              "type": "ip",
              "ignore_malformed": true
            },
            "port": {
              "type": "long",
              "ignore_malformed": true
            }
          }
        },
        "http": {
          "properties": {
            "headers": {
              "properties": {
                "all": {
                  "type": "keyword",
                  "ignore_above": 1024,
                  "fields": {
                    "text": {
                      "type": "text",
                      "norms": false
                    }
                  }
                },
                "forwarded": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "host": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "useragent": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "via": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "x_forwarded_for": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "x_forwarded_proto": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "x_host": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },
            "request": {
              "properties": {
                "body": {
                  "properties": {
                    "bytes": {
                      "type": "long"
                    },
                    "content": {
                      "type": "keyword",
                      "ignore_above": 1024,
                      "fields": {
                        "text": {
                          "type": "text",
                          "norms": false
                        }
                      }
                    }
                  }
                },
                "bytes": {
                  "type": "long"
                },
                "method": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },
            "response": {
              "properties": {
                "bytes": {
                  "type": "long"
                },
                "status_code": {
                  "type": "long"
                }
              }
            },
            "version": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "redir": {
          "properties": {
            "backend": {
              "properties": {
                "name": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },
            "catchall": {
              "type": "text",
              "norms": false
            },
            "frontend": {
              "properties": {
                "ip": {
                  "type": "ip",
                  "ignore_malformed": true
                },
                "name": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "port": {
                  "type": "long",
                  "ignore_malformed": true
                }
              }
            },
            "program": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "timestamp": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "source": {
          "properties": {
            "as": {
              "properties": {
                "number": {
                  "type": "long"
                },
                "organization": {
                  "properties": {
                    "name": {
                      "type": "keyword",
                      "ignore_above": 1024,
                      "fields": {
                        "text": {
                          "type": "text",
                          "norms": false
                        }
                      }
                    }
                  }
                }
              }
            },
            "cdn": {
              "properties": {
                "domain": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "ip": {
                  "type": "ip",
                  "ignore_malformed": true
                },
                "port": {
                  "type": "long",
                  "ignore_malformed": true
                }
              }
            },
            "domain": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "geo": {
              "properties": {
                "city_name": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "continent_code": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "continent_name": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "country_iso_code": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "country_name": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "location": {
                  "type": "geo_point"
                },
                "name": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "postal_code": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "region_iso_code": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "region_name": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "timezone": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },
            "greynoise": {
              "properties": {
                "classification": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "ip": {
                  "type": "ip",
                  "ignore_malformed": true
                },
                "last_seen": {
                  "type": "date",
                  "format": "strict_date_optional_time||yyyy-MM-dd",
                  "ignore_malformed": true
                },
                "link": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "message": {
                  "type": "keyword",
                  "ignore_above": 1024,
                  "fields": {
                    "text": {
                      "type": "text",
                      "norms": false
                    }
                  }
                },
                "name": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "noise": {
                  "type": "boolean"
                },
                "query_timestamp": {
                  "type": "date",
                  "format": "epoch_second||strict_date_optional_time||epoch_millis"
                },
                "riot": {
                  "type": "boolean"
                }
              }
            },
            "ip": {
              "type": "ip",
              "ignore_malformed": true
            },
            "ip_otherproxies": {
              "type": "keyword",
              "ignore_above": 1024,
              "fields": {
                "text": {
                  "type": "text",
                  "norms": false
                }
              }
            },
            "port": {
              "type": "long",
              "ignore_malformed": true
            }
          }
        },
        "user_agent": {
          "properties": {
            "device": {
              "properties": {
                "name": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },
            "name": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "original": {
              "type": "keyword",
              "ignore_above": 1024,
              "fields": {
                "text": {
                  "type": "text",
                  "norms": false
                }
              }
            },
            "os": {
              "properties": {
                "full": {
                  "type": "keyword",
                  "ignore_above": 1024,
                  "fields": {
                    "text": {
                      "type": "text",
                      "norms": false
                    }
                  }
                },
                "name": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "version": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },
            "version": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        }
      }
    }
  },
  "_meta": {
    "managed_by": "redelk",
    "description": "HTTP traffic hitting the redirectors, as parsed by the haproxy, apache and nginx logstash filters. destination.* is the redirector side of the connection and source.* the visitor side; both carry the ECS geoip output, so destination.geo.location and source.geo.location must be geo_point or Kibana cannot draw the maps. user_agent.* is what the logstash useragent filter emits in ECS mode. source.greynoise.query_timestamp is written as epoch seconds by modules/enrich_greynoise and is only usable as a cache marker if the mapping says so.",
    "authors": [
      "Outflank B.V. / Marc Smeets",
      "Lorenzo Bernardi (@fastlorenzo)"
    ]
  }
}
