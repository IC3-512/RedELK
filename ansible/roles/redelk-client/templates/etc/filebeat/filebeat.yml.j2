{{ ansible_managed | comment }}

{% if 'redirs' in group_names %}
filebeat.inputs:
- type: log
  enabled: true
  fields_under_root: true
  paths:
    - /var/log/haproxy.log
  fields:
    infra:
      log:
        type: redirtraffic
    redir:
      program: haproxy
- type: log
  enabled: true
  fields_under_root: true
  paths:
    - /var/log/apache2/access-redelk.log
  fields:
    infra:
      log:
        type: redirtraffic
    redir:
      program: apache
- type: log
  enabled: true
  fields_under_root: true
  paths:
    - /var/log/nginx/access-redelk.log
  fields:
    infra:
      log:
        type: redirtraffic
    redir:
      program: nginx

filebeat.config.modules:
  path: ${path.config}/modules.d/*.yml
  reload.enabled: false

setup.template.settings:
  index.number_of_shards: 3

name: "{{ redelk_identifier | default(inventory_hostname) }}"
fields_under_root: true
fields:
  infra:
    attack_scenario: "{{ redelk_attack_scenario }}"

output.logstash:
  hosts: ["{{ redelk_logstash_endpoint }}"]
  ssl.certificate_authorities: ["{{ redelk_filebeat_ca_path }}"]
{% else %}
filebeat.config.inputs:
  enabled: true
  path: /etc/filebeat/inputs.d/*.yml
  reload.enabled: true
  reload.period: 10s

filebeat.config.modules:
  path: ${path.config}/modules.d/*.yml
  reload.enabled: false

setup.template.settings:
  index.number_of_shards: 3

name: "{{ redelk_identifier | default(inventory_hostname) }}"
fields_under_root: true
harvester.limit: 1

output.logstash:
  hosts: ["{{ redelk_logstash_endpoint }}"]
  ssl.certificate_authorities: ["{{ redelk_filebeat_ca_path }}"]
{% endif %}
