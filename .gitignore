####################################################################################################
# Never commit key material
#
# RedELK generates its own CA and a key pair per redirector and C2 server. One leaked CA key is
# enough to impersonate the whole log collection infrastructure, so the patterns are global rather
# than per directory. .github/workflows/validate.yml enforces the same rule in CI.
####################################################################################################
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.csr
*.srl
id_rsa
id_rsa.pub
id_ecdsa
id_ecdsa.pub
id_ed25519
id_ed25519.pub
htpasswd.users

####################################################################################################
# RedELK v3 - everything below is generated by ./redelkctl
####################################################################################################
# Anchored, so a test fixture that happens to be called redelk.yml can be committed. Unanchored,
# this matched at any depth and silently excluded ansible/molecule/redelk/files/redelk.yml - the
# scenario's own fixture - so CI checked out a tree without it and the Molecule job failed on a
# file that exists on every developer's machine.
/redelk.yml

# NOT anchored, deliberately: generated secrets must never be tracked, wherever they are written.
# Running the molecule scenario leaves one next to its fixture.
redelk.secrets.yml
.redelk-venv/
build/
elkserver/.env
elkserver/mounts/certs/
elkserver/mounts/certbot/
elkserver/mounts/nginx-certs/
elkserver/mounts/redelk-ssh/
elkserver/mounts/logstash-config/certs_inputs/
elkserver/mounts/logstash-config/certs_clients/

__pycache__/
*.pyc

# Generated by redelkctl from redelk.yml (they contain credentials or are derived from them).
elkserver/mounts/bloodhound-config/bloodhound.config.json
elkserver/mounts/nginx-config/htpasswd.users.template
elkserver/mounts/nginx-config/default.conf.template
elkserver/docker-compose.override.yml
