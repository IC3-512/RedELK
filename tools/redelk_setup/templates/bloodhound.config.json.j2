{
  "_comment": "Generated by redelkctl from redelk.yml - do not edit by hand.",
  "version": 1,
  "bind_addr": "0.0.0.0:8080",
  "metrics_port": ":2112",
  "root_url": "https://{{ hostname }}:{{ bloodhound_port }}/",
  "work_dir": "/opt/bloodhound/work",
  "log_level": "INFO",
  "log_path": "bloodhound.log",
  "features": {
    "enable_auth": true
  },
  "tls": {
    "cert_file": "",
    "key_file": ""
  },
  "database": {
    "connection": "user={{ postgres_user }} password={{ postgres_password }} dbname={{ postgres_database }} host=redelk-bloodhound-postgres"
  },
  "neo4j": {
    "connection": "neo4j://neo4j:{{ neo4j_password }}@redelk-bloodhound-neo4j:7687/"
  },
  "collectors_base_path": "/etc/bloodhound/collectors",
  "default_admin": {
    "principal_name": "admin",
    "password": "{{ bloodhound_password }}",
    "first_name": "RedELK",
    "last_name": "Admin",
    "email_address": "{{ admin_email }}"
  }
}
