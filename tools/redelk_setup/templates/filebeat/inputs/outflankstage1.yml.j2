{{ header }}
# Outflank Stage1 C2 implant logs.
#
# Stage1 v2 no longer writes the server-level main.log; implant activity is rendered into
# shared/logs/api/implant_logs/legacy_text/. If your deployment uses a different layout, set
# `paths.base` for this C2 server in redelk.yml.

{% set base = base_path or '/root/stage1c2server' %}

- type: filestream
  id: outflankstage1-implant
  enabled: true
  paths:
    - {{ base }}/shared/logs/api/implant_logs/legacy_text/*.log
  prospector.scanner.check_interval: 5s
  parsers:
    - multiline:
        type: pattern
        # match "2020-04-26 19:49:03 UTC "
        pattern: '^\d\d\d\d\-\d\d\-\d\d\s\d\d:\d\d:\d\d\sUTC\s'
        negate: true
        match: after
        # Filebeat's default is 500 lines, and this input never set it - the Cobalt Strike input
        # always did. A task whose output runs past 500 lines was therefore cut mid-output, which
        # took the terminating ';' with it and made the Logstash grok backtrack over the whole
        # truncated body hunting for one: the event came out tagged _groktimeout with implant.task,
        # task_id, operator and output all missing. Seen on `ls C:\Windows\System32` and on `psx`,
        # so the two commands most likely to produce something worth reading were exactly the two
        # that arrived empty.
        max_lines: 100000
  fields_under_root: true
  fields:
    infra:
      attack_scenario: {{ attack_scenario | to_yaml_scalar }}
      log:
        type: rtops
    c2:
      program: stage1
      log:
        type: implant
