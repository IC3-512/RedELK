{{ header }}
# PoshC2 server log.

{% set base = base_path or '/opt/PoshC2_Project' %}

- type: filestream
  id: poshc2-events
  enabled: true
  paths:
    - {{ base }}/poshc2_server.log
  prospector.scanner.check_interval: 5s
  parsers:
    - include_message:
        patterns:
          - '(.*)implant\s+connected:\s+'
          - '(0[1-9]|[12]\d|3[01])/(0[1-9]|1[0-2])/[12]\d{3}\s+([0-1][0-9]|[2][0-3]):([0-5][0-9]):([0-5][0-9]):(.*?)'
          - 'Download\s+file\s+part\s+(.*?)'
          - 'Screenshot\s+captured:\s+(.*?)'
          - '(.*?)\:(.*?)\s+\|\s+Time:(.*?)\s+\|\s+PID:(.*?)\s+\|\s+Sleep:(.*?)\s+\|\s+(.*?)\s+@\s+(.*?)\s+\((.*?)\)\s+\|\s+URL\:(.*?)'
  fields_under_root: true
  fields:
    infra:
      attack_scenario: {{ attack_scenario | to_yaml_scalar }}
      log:
        type: rtops
    c2:
      program: poshc2
      log:
        type: events
