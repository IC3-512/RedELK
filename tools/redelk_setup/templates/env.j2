{{ header }}
## Docker compose
COMPOSE_PROJECT_NAME=redelk
COMPOSE_PROFILES={{ compose_profiles }}
LOG_MAX_SIZE=200m
LOG_MAX_FILE=1

## Image versions
# The Elastic stack version used for Elasticsearch, Kibana and Logstash. The Filebeat shippers
# on your redirectors and C2 servers are pinned to the same version.
ELASTIC_VERSION={{ elastic.version }}
# The RedELK-built images (redelk-base, redelk-jupyter).
REDELK_IMAGE_REPO={{ elastic.image_repo }}
REDELK_IMAGE_TAG={{ image_tag }}
BLOODHOUND_TAG=latest

## Certificate locations inside the containers
CERTS_DIR_ES=/usr/share/elasticsearch/config/certificates
CERTS_DIR_KBN=/usr/share/kibana/config/certificates
CERTS_DIR_LOGSTASH=/usr/share/logstash/config/certificates
CERTS_DIR_REDELK=/usr/share/logstash/redelk-main/certs
CERTS_LOGSTASH_INPUT_KEY=/usr/share/logstash/redelk-main/certs/elkserver.key
CERTS_LOGSTASH_INPUT_CRT=/usr/share/logstash/redelk-main/certs/elkserver.crt
CERTS_LOGSTASH_INPUT_CA=/usr/share/logstash/redelk-main/certs/redelkCA.crt
CERTS_LOGSTASH_OUTPUT_CA=/usr/share/logstash/config/certificates/ca/ca.crt

## Elasticsearch
ES_URL=https://redelk-elasticsearch:9200
ES_HEAP={{ memory.elasticsearch }}
ELASTIC_PASSWORD={{ secrets.elastic_password }}
CREDS_kibana_system={{ secrets.kibana_system_password }}
CREDS_logstash_system={{ secrets.logstash_system_password }}
CREDS_redelk_ingest={{ secrets.redelk_ingest_password }}
CREDS_redelk={{ secrets.redelk_password }}
KBN_XPACK_ENCRYPTEDSAVEDOBJECTS={{ secrets.kibana_encryption_key }}
KBN_XPACK_REPORTING={{ secrets.kibana_reporting_key }}
KBN_XPACK_SECURITY={{ secrets.kibana_security_key }}

## Logstash beats input
INGEST_PORT={{ server.ingest_port }}
# Require redirectors and C2 servers to present a certificate signed by the RedELK CA.
LOGSTASH_CLIENT_AUTH={{ 'required' if server.tls.mutual_auth else 'none' }}

## Published ports
BIND_KIBANA={{ server.bind.kibana }}
BIND_ELASTICSEARCH={{ server.bind.elasticsearch }}
BIND_NEO4J={{ server.bind.neo4j }}
BIND_BLOODHOUND={{ server.bind.bloodhound }}
PORT_HTTP={{ server.ports.http }}
PORT_HTTPS={{ server.ports.https }}
PORT_BLOODHOUND={{ server.ports.bloodhound }}

## nginx / TLS
# Host directory holding the certificate nginx serves.
CERTS_DIR_NGINX_LOCAL={{ nginx_cert_dir }}
CERTS_DIR_NGINX=/etc/nginx/certs
CERTS_DIR_NGINX_CA_LOCAL=./mounts/certs/ca/
CERTS_DIR_NGINX_CA=/etc/nginx/ca_certs
TLS_NGINX_CRT_PATH=/etc/nginx/certs/fullchain.pem
TLS_NGINX_KEY_PATH=/etc/nginx/certs/privkey.pem
TLS_NGINX_CA_PATH=/etc/nginx/ca_certs/ca.crt
EXTERNAL_DOMAIN={{ config.primary_hostname }}

## Let's Encrypt
LE_ENABLED={{ 'true' if config.letsencrypt else 'false' }}
LE_EMAIL={{ server.tls.letsencrypt.email }}
LE_STAGING={{ '1' if server.tls.letsencrypt.staging else '0' }}

## BloodHound Community Edition / Neo4j / Postgres
# Always defined, even on the limited profile: docker compose warns about variables referenced by
# a service it is not starting, and those warnings look like real errors to an operator.
NEO4J_AUTH=neo4j/{{ secrets.neo4j_password }}
NEO4J_HEAP={{ memory.neo4j }}
POSTGRES_USER=bloodhound
POSTGRES_PASSWORD={{ secrets.postgres_password }}
POSTGRES_DATABASE=bloodhound
